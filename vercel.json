{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.next,.git,node_modules,.venv,.pytest_cache,backend/tests}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?_path=:path"
    }
  ]
}
