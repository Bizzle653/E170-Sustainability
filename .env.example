# =============================================================================
# Green Canopy — Environment Variables
# =============================================================================
# Copy this file to .env.local (for local dev) or configure these values in
# your deployment platform (Vercel, Render, Railway, Docker, etc.).
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# ---- DeepSeek AI (required for the AI Copilot and classification agent) ----
# Obtain from: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# Add the same name as a GitHub Actions repository secret to run the scheduled
# Sustainability Intelligence Agent. Never expose it through NEXT_PUBLIC_*.
# Automatic publication also requires a GitHub Actions secret named
# VERCEL_TOKEN. Create it in Vercel account settings; it is never used by the app.

# ---- Supabase (required for authentication & portfolio persistence) ----
# Obtain from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- Backend API URL (optional — only needed when frontend & backend
#      run on different hosts) ----
# Default in local dev: http://localhost:8000
# In Vercel production this is NOT needed (same-origin via rewrites).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- CORS allowed origins (backend, optional, comma-separated) ----
# Only needed if frontend domains are not in the default list.
# Default allows: localhost:3000, 127.0.0.1:3000, e170-sustaniability-dogi.vercel.app
# GREEN_CANOPY_ALLOWED_ORIGINS=https://your-custom-domain.com

# ---- Site URL (optional — used for Open Graph metadata) ----
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
